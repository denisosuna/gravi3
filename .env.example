# Tutor LLM: any OpenAI-compatible Chat Completions provider
# (Groq, OpenAI, OpenRouter, a local Ollama/vLLM server...).
# Leave LLM_API_KEY empty to run in reduced mode: everything works except the tutor.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# Optional, only for reasoning models: none | minimal | low | medium | high
LLM_REASONING_EFFORT=low
# OpenAI example:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_REASONING_EFFORT=
# Ask the provider for JSON replies; set false if it has no JSON mode.
LLM_JSON_MODE=true
# Explicit tutor switch.
LLM_ENABLED=true
# Provider deadline (ms) and generation budget including reasoning.
LLM_TIMEOUT_MS=15000
LLM_MAX_COMPLETION_TOKENS=2048
# Global in-flight provider calls.
LLM_MAX_CONCURRENT=3
# Fixed-window quotas, held in memory per process.
RATE_LIMIT_IP_PER_MINUTE=5
RATE_LIMIT_IP_PER_HOUR=30
RATE_LIMIT_GLOBAL_PER_HOUR=100
# debug | info | warn | error | silent
LOG_LEVEL=info
# Trusted canonical public URL (on Render it defaults to the external URL).
APP_URL=http://localhost:3000
# Trusted proxies appending to X-Forwarded-For (0 = ignore the header).
# Verify on your deployment before raising it.
TRUSTED_PROXY_HOPS=0
PORT=3000
HOSTNAME=0.0.0.0
