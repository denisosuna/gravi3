# Tutor LLM: any OpenAI-compatible Chat Completions provider.
# Leave LLM_API_KEY empty to run in reduced mode (no tutor).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# Optional, only for reasoning models: low | medium | high
LLM_REASONING_EFFORT=low
# OpenAI example:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_REASONING_EFFORT=
LLM_ENABLED=true
LLM_TIMEOUT_MS=15000
LLM_MAX_COMPLETION_TOKENS=2048
LLM_MAX_CONCURRENT=3
RATE_LIMIT_IP_PER_MINUTE=5
RATE_LIMIT_IP_PER_HOUR=30
RATE_LIMIT_GLOBAL_PER_HOUR=100
LOG_LEVEL=info
APP_URL=http://localhost:3000
# Set only behind a trusted proxy that overwrites this header.
TRUST_PROXY=false
PORT=3000
HOSTNAME=0.0.0.0
